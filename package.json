{
  "name": "local-diffshub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "bun run --hot --no-clear-screen src/server/index.ts",
    "build": "bun run build:web && bun run build:server",
    "build:web": "vite build",
    "build:server": "rm -rf dist/server && bun build src/server/index.ts --target=bun --outdir=dist/server --packages=external",
    "start": "bun run dist/server/index.js",
    "typecheck": "tsgo --build --noEmit tsconfig.json",
    "lint": "bun x ultracite check",
    "fix": "bun x ultracite fix",
    "format": "biome format --write",
    "test": "bun test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.1.4",
    "@hugeicons/react": "^1.1.6",
    "@pierre/diffs": "^1.2.3",
    "@pierre/icons": "^0.5.0",
    "@pierre/theme": "^1.0.3",
    "@pierre/trees": "^1.0.0-beta.4",
    "chokidar": "^3.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/bun": "^1.3.9",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260223.1",
    "@vitejs/plugin-react": "^6.0.1",
    "lefthook": "^2.1.1",
    "shadcn": "^4.8.2",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "ultracite": "7.2.3",
    "vite": "^8.0.12"
  }
}
